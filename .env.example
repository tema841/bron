# Скопируйте этот файл в .env и укажите свои значения.
# Реальные значения в репозиторий не добавляются.

# Порт веб-сервера
PORT=8080

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://postgres:ВАШ_ПАРОЛЬ@localhost:5432/bron

# Секрет подписи JWT (длинная случайная строка)
JWT_SECRET=замените_на_случайную_строку
# Срок действия JWT (например 1h; для проверки истечения можно поставить 60s)
JWT_EXPIRES_IN=1h

# Пароли демонстрационных учётных записей для npm run seed
SEED_ADMIN_PASSWORD=придумайте_пароль
SEED_USER_PASSWORD=придумайте_пароль
