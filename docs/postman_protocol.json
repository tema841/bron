{
  "info": {
    "name": "Бронь без конфликтов — ручная проверка",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Дата проверки D = через 3 дня по Москве (ГГГГ-ММ-ДД)",
          "if (!pm.collectionVariables.get('D')) {",
          "  const d = new Date(Date.now() + 3 * 3600 * 1000 + 3 * 86400 * 1000);",
          "  pm.collectionVariables.set('D', d.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
